# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Postgres + pgvector (docker compose up -d db)
DATABASE_URL=postgresql+psycopg://lorvo:lorvo@localhost:5433/lorvo
# Only needed to run integration tests locally
TEST_DATABASE_URL=postgresql+psycopg://lorvo:lorvo@localhost:5433/lorvo_test

# Embeddings: "local" (BAAI/bge-small-en-v1.5, needs `uv sync --extra local`)
# or "fake" (deterministic hash vectors, for tests only)
EMBEDDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Chunking (tokens, measured with the embedder's tokenizer)
CHUNK_TARGET_TOKENS=350
CHUNK_OVERLAP_TOKENS=50

# Claude (used from step 2 onward)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
